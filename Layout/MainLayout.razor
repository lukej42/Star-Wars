@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="@(IsHomePage ? "main-home" : null)">
        @if (!IsHomePage)
        {
            <div class="top-row px-4">
                <span class="top-row-title">Star Wars Worlds</span>
            </div>
        }

        <article class="content px-4 @(IsHomePage ? "content-home" : null) @(IsPlanetPage ? "content-planet" : "content-galaxy")">
            @Body
        </article>
    </main>
</div>

@code {
    private bool IsHomePage =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').Length == 0;

    private bool IsPlanetPage =>
        Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("planet/", StringComparison.OrdinalIgnoreCase);
}
