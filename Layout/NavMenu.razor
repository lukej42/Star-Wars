                                <span class="nav-settlement-dot" style="background-color: @settlement.Color" aria-hidden="true"></span>
                                @settlement.Name
                            </NavLink>
                        }
                    </div>
                </div>
            </div>
            <div class="nav-item px-3 nav-flyout"
                 @onclick:stopPropagation="true"
