@code {
    private bool collapseNavMenu = true;
    private bool mobileTimelinesOpen;
    private bool mobileFactionsOpen;
    private bool mobileWarsConflictsOpen;
    private bool mobileCharactersOpen;
    private bool mobileJediOpen;
    private bool mobileSithOpen;
    private bool mobileMilitaryUnitsOpen;
    private bool mobilePlanetsOpen;
    private bool mobileShipsOpen;
    private bool mobileSpeciesOpen;
    private bool mobileSettlementsOpen;
    private bool mobileDroidsOpen;
    private bool mobileBountyHuntersOpen;
    private bool mobileForcePowersSubOpen;
    private bool mobileTheForceOpen;
    private bool mobileLightSideOpen;
    private bool mobileDarkSideOpen;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private bool IsTimelineRoute =>
        Navigation.Uri.Contains("/timelines", StringComparison.OrdinalIgnoreCase);

    private bool IsFactionRoute =>
        Navigation.Uri.Contains("/factions/", StringComparison.OrdinalIgnoreCase) ||
        Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').Equals("all-factions", StringComparison.OrdinalIgnoreCase);

    private bool IsWarsConflictsRoute
    {
        get
        {
