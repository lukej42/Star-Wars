    private void CloseOtherFlyouts(string except)
    {
        if (except != nameof(mobileTimelinesOpen))
        {
            mobileTimelinesOpen = false;
        }

        if (except != nameof(mobileFactionsOpen))
        {
            mobileFactionsOpen = false;
        }

        if (except != nameof(mobileWarsConflictsOpen))
        {
            mobileWarsConflictsOpen = false;
        }

        if (except != nameof(mobileCharactersOpen))
        {
            mobileCharactersOpen = false;
        }

        if (except != nameof(mobileJediOpen))
        {
            mobileJediOpen = false;
        }

        if (except != nameof(mobileSithOpen))
        {
            mobileSithOpen = false;
        }

        if (except != nameof(mobileMilitaryUnitsOpen))
        {
            mobileMilitaryUnitsOpen = false;
        }

        if (except != nameof(mobilePlanetsOpen))
        {
            mobilePlanetsOpen = false;
        }

        if (except != nameof(mobileShipsOpen))
        {
            mobileShipsOpen = false;
        }

        if (except != nameof(mobileSpeciesOpen))
        {
            mobileSpeciesOpen = false;
        }

        if (except != nameof(mobileSettlementsOpen))
        {
            mobileSettlementsOpen = false;
        }

        if (except != nameof(mobileDroidsOpen))
        {
            mobileDroidsOpen = false;
        }

        if (except != nameof(mobileBountyHuntersOpen))
        {
            mobileBountyHuntersOpen = false;
        }

        if (except != nameof(mobileTheForceOpen))
        {
            mobileTheForceOpen = false;
        }

        if (except != nameof(mobileForcePowersSubOpen))
        {
            mobileForcePowersSubOpen = false;
        }
    }

