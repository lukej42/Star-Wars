    private void ToggleMilitaryFaction(string slug)
    {
        openMilitaryFactionSlug = openMilitaryFactionSlug == slug ? null : slug;
        if (openMilitaryFactionSlug != slug)
        {
            openMilitaryBranchKey = null;
        }
    }

    private void ToggleMilitaryBranch(string factionSlug, MilitaryUnitBranch branch)
    {
        var key = GetMilitaryBranchKey(factionSlug, branch);
        openMilitaryBranchKey = openMilitaryBranchKey == key ? null : key;
        openMilitaryFactionSlug = factionSlug;
    }

    private void CloseMilitaryBranch(string factionSlug, MilitaryUnitBranch branch)
    {
        var key = GetMilitaryBranchKey(factionSlug, branch);
        if (openMilitaryBranchKey == key)
        {
            openMilitaryBranchKey = null;
        }
    }

    private static string GetMilitaryBranchKey(string factionSlug, MilitaryUnitBranch branch) =>
        $"{factionSlug}-{branch.ToString().ToLowerInvariant()}";

    private bool IsMilitaryBranchRoute(string factionSlug, MilitaryUnitBranch branch)
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();
        var prefix = $"military-units/{factionSlug}/{branch.ToString().ToLowerInvariant()}";
        return uri.Equals(prefix, StringComparison.OrdinalIgnoreCase)
            || uri.StartsWith($"{prefix}/", StringComparison.OrdinalIgnoreCase);
    }

    private void CloseMilitaryFaction(string slug)
    {
        if (openMilitaryFactionSlug == slug)
        {
            openMilitaryFactionSlug = null;
        }
    }

    private void ToggleWarConflict(string slug)
    {
        openWarSlug = openWarSlug == slug ? null : slug;
    }

    private void CloseWarConflict(string slug)
    {
        if (openWarSlug == slug)
        {
            openWarSlug = null;
        }
    }

    private void ToggleMobileForcePowersSub()
    {
        mobileForcePowersSubOpen = !mobileForcePowersSubOpen;
        if (mobileForcePowersSubOpen)
