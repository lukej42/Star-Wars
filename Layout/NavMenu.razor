    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("starWarsNav.init");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("starWarsNav.dispose");
        }
        catch
        {
            // Ignore disconnect errors during teardown.
        }
    }

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private bool IsTimelineRoute =>
        Navigation.Uri.Contains("/timelines", StringComparison.OrdinalIgnoreCase);

    private bool IsChroniclesRoute
    {
        get
        {
            var uri = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();

            if (uri.Equals(ChroniclesData.GalacticHistoryRoute, StringComparison.OrdinalIgnoreCase) ||
                uri.StartsWith("chronicles/galactic-history/", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }

            return uri.Equals("chronicles", StringComparison.OrdinalIgnoreCase) ||
                ChroniclesData.Entries.Any(entry =>
                uri.Equals(entry.Route, StringComparison.OrdinalIgnoreCase) ||
                uri.StartsWith($"{entry.Route}/", StringComparison.OrdinalIgnoreCase));
        }
    }

    private bool IsFactionRoute =>
        Navigation.Uri.Contains("/factions/", StringComparison.OrdinalIgnoreCase) ||
        Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').Equals("all-factions", StringComparison.OrdinalIgnoreCase);

    private bool IsWarsConflictsRoute
    {
        get
        {
            var uri = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();

            if (uri.StartsWith("wars-conflicts/battles/", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }

            return WarConflictData.Conflicts.Any(conflict =>
                uri.Equals(conflict.Route, StringComparison.OrdinalIgnoreCase) ||
                uri.StartsWith($"{conflict.Route}/", StringComparison.OrdinalIgnoreCase));
        }
    }

    private bool IsWarConflictRoute(string slug)
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();
        var conflict = WarConflictData.Conflicts.FirstOrDefault(entry => entry.Slug.Equals(slug, StringComparison.OrdinalIgnoreCase));
        if (conflict is null)
        {
            return false;
        }

        return uri.Equals(conflict.Route, StringComparison.OrdinalIgnoreCase)
            || uri.StartsWith($"{conflict.Route}/", StringComparison.OrdinalIgnoreCase)
            || BattleData.GetByWar(conflict.Slug).Any(battle =>
                uri.Equals(battle.Route, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsCharacterDirectoryRoute
    {
        get
        {
            var uri = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();

            if (uri is "all-characters")
            {
                return true;
            }

            return CharacterData.Characters.Any(character =>
                uri.Equals(character.Route, StringComparison.OrdinalIgnoreCase) ||
                uri.StartsWith($"{character.Route}/", StringComparison.OrdinalIgnoreCase));
        }
    }

