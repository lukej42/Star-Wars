                 @onmouseleave="CloseMobileWarsConflicts">
                <button type="button"
                        class="nav-link nav-flyout-trigger @(IsWarsConflictsRoute ? "active" : null)"
                        @onclick="ToggleMobileWarsConflicts">
                    <span class="bi bi-wars-conflicts-nav-menu" aria-hidden="true"></span> Wars &amp; Conflicts
                    <span class="nav-flyout-chevron" aria-hidden="true"></span>
                </button>
                <div class="nav-flyout-menu @(mobileWarsConflictsOpen ? "is-open" : null)">
                    <div class="nav-flyout-panel">
                        @foreach (var conflict in WarConflictData.Conflicts)
                        {
                            <NavLink class="nav-link nav-flyout-link nav-war-conflict-link" href="@conflict.Route" @onclick="CloseMobileNav">
