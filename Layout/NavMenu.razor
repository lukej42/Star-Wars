                <div class="nav-flyout-menu @(mobileMilitaryUnitsOpen ? "is-open" : null)">
                    <div class="nav-flyout-panel nav-flyout-panel-military-units">
                        @foreach (var faction in MilitaryUnitData.Factions.OrderBy(faction => faction.Name))
                        {
                            <NavLink class="nav-link nav-flyout-link nav-military-unit-link" href="@faction.Route" @onclick="CloseMobileNav">
                                <span class="nav-military-unit-dot" style="background-color: @faction.Color" aria-hidden="true"></span>
                                @faction.Name
                            </NavLink>
                        }
                    </div>
                </div>
            </div>
            <div class="nav-item px-3 nav-flyout"
                 @onclick:stopPropagation="true"
                 @onmouseleave="CloseMobilePlanets">
                <button type="button"
                        class="nav-link nav-flyout-trigger @(IsPlanetDirectoryRoute ? "active" : null)"
                        @onclick="ToggleMobilePlanets">
                    <span class="bi bi-planets-directory-nav-menu" aria-hidden="true"></span> Planets Directory
                    <span class="nav-flyout-chevron" aria-hidden="true"></span>
                </button>
                <div class="nav-flyout-menu @(mobilePlanetsOpen ? "is-open" : null)">
                    <div class="nav-flyout-panel nav-flyout-panel-scroll">
                        <NavLink class="nav-link nav-flyout-link nav-planet-link nav-all-planets-link" href="all-planets" @onclick="CloseMobileNav">
                            <span class="bi bi-all-planets-nav-menu" aria-hidden="true"></span>
                            All Planets
                        </NavLink>
                        <div class="nav-flyout-divider" aria-hidden="true"></div>
                        @foreach (var planet in GalaxyData.Planets.OrderBy(planet => planet.Name))
                        {
                            <NavLink class="nav-link nav-flyout-link nav-planet-link" href="@planet.Route" @onclick="CloseMobileNav">
                                <span class="nav-planet-dot" style="background-color: @planet.Color" aria-hidden="true"></span>
                                @planet.Name
                            </NavLink>
                        }
                    </div>
                </div>
            </div>
            <div class="nav-item px-3 nav-flyout"
                 @onclick:stopPropagation="true"
                 @onmouseleave="CloseMobileShips">
                <button type="button"
                        class="nav-link nav-flyout-trigger @(IsShipDirectoryRoute ? "active" : null)"
                        @onclick="ToggleMobileShips">
                    <span class="bi bi-ships-directory-nav-menu" aria-hidden="true"></span> Ships Directory
                    <span class="nav-flyout-chevron" aria-hidden="true"></span>
                </button>
                <div class="nav-flyout-menu @(mobileShipsOpen ? "is-open" : null)">
                    <div class="nav-flyout-panel nav-flyout-panel-scroll nav-flyout-panel-wide nav-flyout-panel-ships">
                        <NavLink class="nav-link nav-flyout-link nav-ship-link nav-all-ships-link" href="all-ships" @onclick="CloseMobileNav">
                            <span class="bi bi-all-ships-nav-menu" aria-hidden="true"></span>
                            All Ships
                        </NavLink>
                        <div class="nav-flyout-divider" aria-hidden="true"></div>
                        @foreach (var ship in ShipData.Ships.OrderBy(ship => ship.Name))
                        {
                            <NavLink class="nav-link nav-flyout-link nav-ship-link" href="@ship.Route" @onclick="CloseMobileNav">
                                <span class="nav-ship-dot" style="background-color: @ship.Color" aria-hidden="true"></span>
                                @ship.Name
                            </NavLink>
                        }
                    </div>
                </div>
            </div>
            <div class="nav-item px-3 nav-flyout"
                 @onclick:stopPropagation="true"
                 @onmouseleave="CloseMobileSpecies">
                <button type="button"
                        class="nav-link nav-flyout-trigger @(IsSpeciesDirectoryRoute ? "active" : null)"
                        @onclick="ToggleMobileSpecies">
                    <span class="bi bi-species-directory-nav-menu" aria-hidden="true"></span> Species Directory
                    <span class="nav-flyout-chevron" aria-hidden="true"></span>
                </button>
                <div class="nav-flyout-menu @(mobileSpeciesOpen ? "is-open" : null)">
                    <div class="nav-flyout-panel nav-flyout-panel-scroll nav-flyout-panel-wide">
                        <NavLink class="nav-link nav-flyout-link nav-species-link nav-all-species-link" href="all-species" @onclick="CloseMobileNav">
                            <span class="bi bi-all-species-nav-menu" aria-hidden="true"></span>
                            All Species
                        </NavLink>
                        <div class="nav-flyout-divider" aria-hidden="true"></div>
                        @foreach (var species in SpeciesData.SpeciesList.OrderBy(species => species.Name))
                        {
                            <NavLink class="nav-link nav-flyout-link nav-species-link" href="@species.Route" @onclick="CloseMobileNav">
                                <span class="nav-species-dot" style="background-color: @species.Color" aria-hidden="true"></span>
                                @species.Name
                            </NavLink>
                        }
                    </div>
                </div>
            </div>
            <div class="nav-item px-3 nav-flyout"
                 @onclick:stopPropagation="true"
                 @onmouseleave="CloseMobileSettlements">
                <button type="button"
                        class="nav-link nav-flyout-trigger @(IsSettlementDirectoryRoute ? "active" : null)"
                        @onclick="ToggleMobileSettlements">
                    <span class="bi bi-settlements-directory-nav-menu" aria-hidden="true"></span> Cities &amp; Settlements
                    <span class="nav-flyout-chevron" aria-hidden="true"></span>
                </button>
                <div class="nav-flyout-menu @(mobileSettlementsOpen ? "is-open" : null)">
                    <div class="nav-flyout-panel nav-flyout-panel-scroll nav-flyout-panel-wide">
                        <NavLink class="nav-link nav-flyout-link nav-settlement-link nav-all-settlements-link" href="all-cities-settlements" @onclick="CloseMobileNav">
                            <span class="bi bi-all-settlements-nav-menu" aria-hidden="true"></span>
                            All Cities &amp; Settlements
                        </NavLink>
                        <div class="nav-flyout-divider" aria-hidden="true"></div>
