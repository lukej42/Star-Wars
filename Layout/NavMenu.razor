                            All Factions
                        </NavLink>
                        <div class="nav-flyout-divider" aria-hidden="true"></div>
                        @foreach (var faction in MilitaryUnitData.Factions.OrderBy(faction => faction.Name))
                        {
                            <div class="nav-subflyout"
                                 @onclick:stopPropagation="true"
                                 @onmouseleave="() => CloseMilitaryFaction(faction.Slug)">
                                <button type="button"
                                        class="nav-link nav-flyout-trigger nav-flyout-link nav-subflyout-trigger @(IsMilitaryFactionRoute(faction.Slug) ? "active" : null)"
                                        @onclick="() => ToggleMilitaryFaction(faction.Slug)">
                                    <span class="nav-military-unit-dot" style="background-color: @faction.Color" aria-hidden="true"></span>
                                    @faction.Name
                                    <span class="nav-flyout-chevron" aria-hidden="true"></span>
                                </button>
                                <div class="nav-subflyout-menu @(openMilitaryFactionSlug == faction.Slug ? "is-open" : null)">
                                    <div class="nav-flyout-panel nav-flyout-panel-military-units">
                                        <NavLink class="nav-link nav-flyout-link nav-military-unit-link" href="@faction.Route" @onclick="CloseMobileNav">
                                            All Military Units
                                        </NavLink>
                                        <div class="nav-flyout-divider" aria-hidden="true"></div>
                                        <div class="nav-subflyout"
                                             @onclick:stopPropagation="true"
                                             @onmouseleave="() => CloseMilitaryBranch(faction.Slug, MilitaryUnitBranch.Army)">
                                            <button type="button"
                                                    class="nav-link nav-flyout-trigger nav-flyout-link nav-subflyout-trigger @(IsMilitaryBranchRoute(faction.Slug, MilitaryUnitBranch.Army) ? "active" : null)"
                                                    @onclick="() => ToggleMilitaryBranch(faction.Slug, MilitaryUnitBranch.Army)">
                                                Army
                                                <span class="nav-flyout-chevron" aria-hidden="true"></span>
                                            </button>
                                            <div class="nav-subflyout-menu @(openMilitaryBranchKey == GetMilitaryBranchKey(faction.Slug, MilitaryUnitBranch.Army) ? "is-open" : null)">
                                                <div class="nav-flyout-panel nav-flyout-panel-scroll nav-flyout-panel-military-units">
                                                    <NavLink class="nav-link nav-flyout-link nav-military-unit-link" href="@faction.ArmyRoute" @onclick="CloseMobileNav">
                                                        All Army Units
                                                    </NavLink>
                                                    <div class="nav-flyout-divider" aria-hidden="true"></div>
                                                    @foreach (var unit in MilitaryUnitData.GetArmyUnits(faction.Slug))
                                                    {
                                                        <NavLink class="nav-link nav-flyout-link nav-military-unit-link" href="@unit.Route" @onclick="CloseMobileNav">
                                                            <span class="nav-military-unit-dot" style="background-color: @unit.Color" aria-hidden="true"></span>
                                                            @unit.Name
                                                        </NavLink>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="nav-subflyout"
                                             @onclick:stopPropagation="true"
                                             @onmouseleave="() => CloseMilitaryBranch(faction.Slug, MilitaryUnitBranch.Navy)">
                                            <button type="button"
                                                    class="nav-link nav-flyout-trigger nav-flyout-link nav-subflyout-trigger @(IsMilitaryBranchRoute(faction.Slug, MilitaryUnitBranch.Navy) ? "active" : null)"
                                                    @onclick="() => ToggleMilitaryBranch(faction.Slug, MilitaryUnitBranch.Navy)">
                                                Navy
                                                <span class="nav-flyout-chevron" aria-hidden="true"></span>
                                            </button>
                                            <div class="nav-subflyout-menu @(openMilitaryBranchKey == GetMilitaryBranchKey(faction.Slug, MilitaryUnitBranch.Navy) ? "is-open" : null)">
                                                <div class="nav-flyout-panel nav-flyout-panel-scroll nav-flyout-panel-military-units">
                                                    <NavLink class="nav-link nav-flyout-link nav-military-unit-link" href="@faction.NavyRoute" @onclick="CloseMobileNav">
                                                        All Navy Units
                                                    </NavLink>
                                                    <div class="nav-flyout-divider" aria-hidden="true"></div>
                                                    @foreach (var group in MilitaryUnitData.GetNavyUnits(faction.Slug).GroupBy(unit => unit.NavyClass ?? unit.UnitType).OrderBy(group => group.Key))
                                                    {
                                                        <div class="nav-flyout-divider nav-flyout-divider-label" aria-hidden="true">@group.Key</div>
                                                        @foreach (var unit in group)
                                                        {
                                                            <NavLink class="nav-link nav-flyout-link nav-military-unit-link" href="@unit.Route" @onclick="CloseMobileNav">
                                                                <span class="nav-military-unit-dot" style="background-color: @unit.Color" aria-hidden="true"></span>
                                                                @unit.Name
                                                            </NavLink>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
