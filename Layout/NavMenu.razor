                                                <div class="nav-flyout-divider" aria-hidden="true"></div>
                                                @foreach (var power in ForcePowerData.DarkSidePowers.OrderBy(power => power.Name))
                                                {
                                                    <NavLink class="nav-link nav-flyout-link nav-force-power-link nav-dark-side-link" href="@power.Route" @onclick="CloseMobileNav">
