                                                {
                                                    <NavLink class="nav-link nav-flyout-link nav-force-power-link nav-light-side-link" href="@power.Route" @onclick="CloseMobileNav">
                                                        <span class="nav-force-power-dot" style="background-color: @power.Color" aria-hidden="true"></span>
                                                        @power.Name
                                                    </NavLink>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="nav-subflyout"
                                         @onclick:stopPropagation="true"
                                         @onmouseleave="CloseMobileDarkSide">
                                        <button type="button"
                                                class="nav-link nav-flyout-trigger nav-flyout-link nav-subflyout-trigger @(IsDarkSideForceRoute ? "active" : null)"
