            <div class="nav-item px-3 nav-flyout"
                 @onclick:stopPropagation="true"
                 @onmouseleave="CloseMobileTheForce">
                <button type="button"
                        class="nav-link nav-flyout-trigger @(IsTheForceRoute ? "active" : null)"
                        @onclick="ToggleMobileTheForce">
                    <span class="bi bi-the-force-nav-menu" aria-hidden="true"></span> The Force
                    <span class="nav-flyout-chevron" aria-hidden="true"></span>
                </button>
                <div class="nav-flyout-menu @(mobileTheForceOpen ? "is-open" : null)">
                    <div class="nav-flyout-panel">
                        <div class="nav-subflyout"
                             @onclick:stopPropagation="true"
                             @onmouseleave="CloseMobileForcePowersSub">
                            <button type="button"
                                    class="nav-link nav-flyout-trigger nav-flyout-link nav-subflyout-trigger @(IsForcePowersSubRoute ? "active" : null)"
                                    @onclick="ToggleMobileForcePowersSub">
                                <span class="bi bi-force-powers-nav-menu" aria-hidden="true"></span>
                                Force Powers
                                <span class="nav-flyout-chevron" aria-hidden="true"></span>
                            </button>
                            <div class="nav-subflyout-menu @(mobileForcePowersSubOpen ? "is-open" : null)">
                                <div class="nav-flyout-panel">
                                    <NavLink class="nav-link nav-flyout-link nav-force-power-link nav-all-force-powers-link" href="all-force-powers" @onclick="CloseMobileNav">
                                        <span class="bi bi-all-force-powers-nav-menu" aria-hidden="true"></span>
                                        All Force Powers
                                    </NavLink>
                                    <div class="nav-subflyout"
                                         @onclick:stopPropagation="true"
                                         @onmouseleave="CloseMobileLightSide">
                                        <button type="button"
                                                class="nav-link nav-flyout-trigger nav-flyout-link nav-subflyout-trigger @(IsLightSideForceRoute ? "active" : null)"
                                                @onclick="ToggleMobileLightSide">
                                            <span class="bi bi-light-side-powers-nav-menu" aria-hidden="true"></span>
                                            Light Side Powers
                                            <span class="nav-flyout-chevron" aria-hidden="true"></span>
