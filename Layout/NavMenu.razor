    private bool IsTheForceRoute => IsForcePowersSubRoute || IsTheForceTopicRoute;

    private bool IsTheForceTopicRoute
    {
        get
        {
            var uri = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();
            var conflict = TheForceTopicData.ConflictBetweenLightAndDark.Route;

            if (uri.Equals(conflict, StringComparison.OrdinalIgnoreCase) ||
                uri.StartsWith($"{conflict}/", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }

            return TheForceTopicData.Topics.Any(topic =>
                uri.Equals(topic.Route, StringComparison.OrdinalIgnoreCase) ||
                uri.StartsWith($"{topic.Route}/", StringComparison.OrdinalIgnoreCase))
                || IsLightsaberFormRoute;
        }
    }

    private bool IsForcePowersSubRoute
    {
        get
        {
            var uri = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();

            if (uri is "all-force-powers" or "all-light-side-powers" or "all-dark-side-powers")
            {
                return true;
            }

            return ForcePowerData.Powers.Any(power =>
                uri.Equals(power.Route, StringComparison.OrdinalIgnoreCase) ||
                uri.StartsWith($"{power.Route}/", StringComparison.OrdinalIgnoreCase));
