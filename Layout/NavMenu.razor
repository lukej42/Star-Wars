@using StarWars.Data
@using StarWars.Models
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Star Wars</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-section nav-section-top">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="galaxy-map">
                    <span class="bi bi-galaxy-map-nav-menu" aria-hidden="true"></span> Galaxy Map
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-flyout"
                 @onclick:stopPropagation="true"
                 @onmouseleave="CloseMobileTimelines">
                <button type="button"
                        class="nav-link nav-flyout-trigger @(IsTimelineRoute ? "active" : null)"
                        @onclick="ToggleMobileTimelines">
                    <span class="bi bi-timelines-nav-menu" aria-hidden="true"></span> Timelines
                    <span class="nav-flyout-chevron" aria-hidden="true"></span>
                </button>
                <div class="nav-flyout-menu @(mobileTimelinesOpen ? "is-open" : null)">
                    <div class="nav-flyout-panel">
                        <NavLink class="nav-link nav-flyout-link nav-timeline-link nav-full-timeline-link" href="timelines" @onclick="CloseMobileNav">
                            <span class="bi bi-full-timeline-nav-menu" aria-hidden="true"></span>
                            Full Timeline
                        </NavLink>
                        <div class="nav-flyout-divider" aria-hidden="true"></div>
                        @foreach (var era in TimelineData.Eras)
                        {
                            <NavLink class="nav-link nav-flyout-link nav-timeline-link" href="@era.Route" @onclick="CloseMobileNav">
                                <span class="nav-timeline-dot" style="background-color: @era.Color" aria-hidden="true"></span>
                                @era.Name
                            </NavLink>
                        }
                    </div>
                </div>
            </div>
            <div class="nav-item px-3 nav-flyout"
                 @onclick:stopPropagation="true"
                 @onmouseleave="CloseMobileChronicles">
                <button type="button"
                        class="nav-link nav-flyout-trigger @(IsChroniclesRoute ? "active" : null)"
                        @onclick="ToggleMobileChronicles">
                    <span class="bi bi-chronicles-nav-menu" aria-hidden="true"></span> Chronicles
                    <span class="nav-flyout-chevron" aria-hidden="true"></span>
                </button>
                <div class="nav-flyout-menu @(mobileChroniclesOpen ? "is-open" : null)">
                    <div class="nav-flyout-panel nav-flyout-panel-scroll nav-flyout-panel-chronicles">
                        <NavLink class="nav-link nav-flyout-link nav-chronicles-link nav-galactic-history-link" href="@ChroniclesData.GalacticHistoryRoute" @onclick="CloseMobileNav">
                            <span class="bi bi-galactic-history-nav-menu" aria-hidden="true"></span>
                            Galactic History
                        </NavLink>
                        <div class="nav-flyout-divider" aria-hidden="true"></div>
                        @foreach (var entry in ChroniclesData.Entries)
                        {
                            <NavLink class="nav-link nav-flyout-link nav-chronicles-link" href="@entry.Route" @onclick="CloseMobileNav">
                                <span class="nav-chronicles-dot" style="background-color: @entry.Color" aria-hidden="true"></span>
                                @entry.Name
                            </NavLink>
                        }
                    </div>
                </div>
            </div>
