<div class="planet-page">
    <img class="planet-page-bg" src="@ImageUrls.Resolve(ImagePath)" alt="" aria-hidden="true" />
    <div class="planet-page-overlay"></div>
    <div class="planet-page-content">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string ImagePath { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
