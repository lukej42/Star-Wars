@page "/the-force/lightsaber-forms/{Slug}"
@using StarWars.Data
@using StarWars.Models
@using StarWars.Services
@using StarWars.Components
@inject EntityCrossLinkService CrossLinkService

<PageTitle>@(form?.Name ?? "Lightsaber Form")</PageTitle>

@if (form is null || content is null)
{
    <h1>Form not found</h1>
    <p>Sorry, there are no records for this lightsaber form.</p>
}
else
{
    <DirectoryDetailShell Name="@form.Name"
                          HeroImagePath="@form.HeroImagePath"
                          HeroImageAlt="@($"Cinematic illustration of {form.Name}")"
                          ShowPortraitHero="false"
                          Subtitle="@form.Style"
                          OverviewText="@content.Overview"
                          HistoryText="@content.History"
                          SignificanceText="@content.Significance"
                          SignificanceHeading="Combat philosophy"
                          NotableEvents="@content.Practitioners"
                          Affiliations="@content.References"
                          AccentColor="@form.Color" />
    <EntityCrossLinks Links="@crossLinks" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private LightsaberForm? form;
    private LightsaberFormContent? content;
    private IReadOnlyList<EntityCrossLink> crossLinks = [];

    protected override async Task OnParametersSetAsync()
    {
        form = LightsaberFormData.GetBySlug(Slug);
        content = LightsaberFormContentData.GetBySlug(Slug);
        crossLinks = form is null
            ? []
            : await CrossLinkService.GetLinksAsync("lightsaber-forms", form.Slug);
    }
}
