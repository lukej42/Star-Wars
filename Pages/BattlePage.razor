@page "/wars-conflicts/battles/{Slug}"
@using StarWars.Data
@using StarWars.Models
@using StarWars.Services
@using StarWars.Components
@inject DirectoryProfileService ProfileService
@inject EntityCrossLinkService CrossLinkService

<PageTitle>@(battle?.Name ?? "Battle")</PageTitle>

@if (battle is null)
{
    <h1>Battle not found</h1>
    <p>Sorry, there are no records for this battle.</p>
}
else if (!profileLoaded)
{
    <p class="directory-detail-loading">Loading battle records…</p>
}
else
{
    var war = WarConflictData.GetBySlug(battle.WarSlug);
    <DirectoryDetailShell Name="@battle.Name"
                          HeroImagePath="@battle.HeroImagePath"
                          HeroImageAlt="@($"Cinematic depiction of the {battle.Name}")"
                          ShowPortraitHero="false"
                          Subtitle="@($"{war?.Name ?? battle.WarSlug} · {battle.Era}")"
                          MetaLine="@(string.IsNullOrWhiteSpace(profile?.DateRange) ? null : $"Date range: {profile!.DateRange}")"
                          Location="@(profile?.Planets.Count > 0 ? profile!.Planets[0] : BattlePlanetData.GetLink(battle.Slug))"
                          OverviewText="@(profile?.Overview ?? BattleOverview)"
                          HistoryText="@(profile?.History ?? BattleHistory)"
                          SignificanceText="@(profile?.Significance ?? BattleSignificance)"
                          SignificanceHeading="Legacy and impact"
                          NotableEvents="@(profile?.NotableEvents ?? BattleEvents)"
                          NotableEventsAsideImagePath="@NotableEventsAsideImagePath"
                          NotableEventsAsideImageAlt="@NotableEventsAsideImageAlt"
                          MajorEvents="@(profile?.MajorEvents ?? Array.Empty<ProfileLinkedEvent>())"
                          KeyFactions="@(profile?.KeyFactions ?? Array.Empty<ProfileLinkItem>())"
                          MajorCharacters="@(profile?.MajorCharacters ?? Array.Empty<ProfileLinkItem>())"
                          JediFallen="@(profile?.JediFallen ?? Array.Empty<ProfileLinkItem>())"
                          JediSurvived="@(profile?.JediSurvived ?? Array.Empty<ProfileLinkItem>())"
                          Planets="@(profile?.Planets ?? Array.Empty<ProfileLinkItem>())"
                          Ships="@(profile?.Ships ?? Array.Empty<ProfileLinkItem>())"
                          Films="@(profile?.Films ?? Array.Empty<string>())"
                          Series="@(profile?.Series ?? Array.Empty<string>())"
                          Games="@(profile?.Games ?? Array.Empty<string>())"
                          Books="@(profile?.Books ?? Array.Empty<string>())"
                          Affiliations="@(profile?.Affiliations ?? BattleReferences)"
                          Timeline="@(profile?.Timeline ?? Array.Empty<ProfileTimelineEntry>())"
                          Gallery="@(profile?.Gallery ?? Array.Empty<ProfileImage>())"
                          Government="@profile?.Government"
                          HeadOfState="@profile?.HeadOfState"
                          AccentColor="@battle.Color" />
    <EntityCrossLinks Links="@crossLinks" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private FamousBattle? battle;
    private DirectoryProfile? profile;
    private bool profileLoaded;
    private IReadOnlyList<EntityCrossLink> crossLinks = [];

    private string BattleOverview =>
        battle is null ? string.Empty :
        $"The {battle.Name} was a pivotal engagement during the {battle.Era}, shaping the outcome of its parent conflict and echoing through records from the nine saga films, series, Knights of the Old Republic, and the Old Sith Empire.";

    private string BattleHistory =>
        battle is null ? string.Empty :
        $"Forces clashed at {battle.Name} with strategic objectives that shifted the balance of power in the galaxy. Commanders on both sides committed fleets, armies, and Force-sensitive warriors to secure victory.\n\nHolorecords, veteran testimony, and archaeological surveys preserve the battle's timeline—from opening maneuvers through the decisive moment that ended the fighting.";

    private string BattleSignificance =>
        battle is null ? string.Empty :
        $"{battle.Name} remains studied in academies and remembered in memorials. Its tactics influenced later campaigns, and its survivors went on to shape the next era of galactic history.";

    private IReadOnlyList<string> BattleEvents =>
        battle is null ? [] :
        [
            $"Fought during the {battle.Era}",
            "Referenced in saga films and animated series",
            "Documented in KOTOR-era and Old Sith Empire archives"
        ];

    private IReadOnlyList<string> BattleReferences =>
        battle is null ? [] :
        [
            "Nine saga films",
            "Live-action and animated series",
            "Knights of the Old Republic",
            "Old Sith Empire records"
        ];

    private string NotableEventsAsideImagePath =>
        battle?.Slug.Equals("jedi-purge", StringComparison.OrdinalIgnoreCase) == true
            ? "/images/wars-conflicts/battles/jedi-purge-order-66-felucia.webp"
            : string.Empty;

    private string NotableEventsAsideImageAlt =>
        battle?.Slug.Equals("jedi-purge", StringComparison.OrdinalIgnoreCase) == true
            ? "Clone troopers execute Order 66 against a Jedi general on a jungle battlefield"
            : string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        battle = BattleData.GetBySlug(Slug);
        profileLoaded = false;
        profile = null;
        crossLinks = [];

        if (battle is not null)
        {
            profile = await ProfileService.GetProfileAsync("battles", battle.Slug);
            crossLinks = await CrossLinkService.GetLinksAsync("battles", battle.Slug);
        }

        profileLoaded = true;
    }
}
