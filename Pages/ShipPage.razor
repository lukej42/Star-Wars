@page "/ships/{Slug}"
@using StarWars.Data
@using StarWars.Models
@using StarWars.Services
@using StarWars.Components
@inject DirectoryProfileService ProfileService

<PageTitle>@(ship?.Name ?? "Ship")</PageTitle>

@if (ship is null)
{
    <h1>Ship not found</h1>
    <p>Sorry, there are no records for this vessel.</p>
}
else if (!profileLoaded)
{
    <p class="directory-detail-loading">Loading ship records…</p>
}
else
{
    <DirectoryDetailShell Name="@ship.Name"
                          HeroImagePath="@ship.ImagePath"
                          HeroImageAlt="@($"Illustration of the {ship.Name}")"
                          Subtitle="@ship.Class"
                          MetaLine="@($"Production: {ship.ProductionCount} · {ship.Era}")"
                          OverviewText="@(profile?.Overview ?? ship.Description)"
                          HistoryText="@(profile?.History ?? string.Empty)"
                          SignificanceText="@(profile?.Significance ?? string.Empty)"
                          SignificanceHeading="Design and service record"
                          NotableEvents="@(profile?.NotableEvents ?? Array.Empty<string>())"
                          Affiliations="@(profile?.Affiliations ?? Array.Empty<string>())"
                          Timeline="@(profile?.Timeline ?? Array.Empty<ProfileTimelineEntry>())"
                          Gallery="@(profile?.Gallery ?? Array.Empty<ProfileImage>())"
                          AccentColor="@ship.Color" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private Ship? ship;
    private DirectoryProfile? profile;
    private bool profileLoaded;

    protected override async Task OnParametersSetAsync()
    {
        ship = ShipData.GetBySlug(Slug);
        profileLoaded = false;
        profile = null;

        if (ship is not null)
        {
            profile = await ProfileService.GetProfileAsync("ships", ship.Slug);
        }

        profileLoaded = true;
    }
}
