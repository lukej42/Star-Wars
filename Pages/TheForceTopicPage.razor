@page "/the-force/{Slug}"
@using StarWars.Data
@using StarWars.Components

<PageTitle>@(topic?.Name ?? "The Force")</PageTitle>

@if (topic is null)
{
    <h1>Topic not found</h1>
    <p>Sorry, there are no records for this Force topic.</p>
}
else if (content is null)
{
    <h1>@topic.Name</h1>
    <p class="all-planets-intro">Detailed content for @topic.Name is coming soon.</p>
}
else
{
    <DirectoryDetailShell Name="@topic.Name"
                          HeroImagePath="@HeroImagePath"
                          HeroImageAlt="@($"Cinematic illustration for {topic.Name}")"
                          ShowPortraitHero="false"
                          Quote="@(content.Quote ?? string.Empty)"
                          OverviewText="@content.Overview"
                          HistoryText="@content.History"
                          SignificanceText="@content.Significance"
                          SignificanceHeading="Significance across galactic history"
                          NotableEvents="@content.NotableEvents"
                          Affiliations="@content.References"
                          AccentColor="@topic.Color" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private TheForceTopic? topic;
    private ForceTopicContent? content;

    private string HeroImagePath => topic?.HeroImagePath ?? string.Empty;

    protected override void OnParametersSet()
    {
        topic = TheForceTopicData.GetBySlug(Slug);
        content = TheForceContentData.GetBySlug(Slug);
    }
}
