@page "/creatures/{Slug}"
@using StarWars.Data
@using StarWars.Models
@using StarWars.Services
@using StarWars.Components
@inject DirectoryProfileService ProfileService
@inject EntityCrossLinkService CrossLinkService
@inject EntityLocationService LocationService

<PageTitle>@(creature?.Name ?? "Creature")</PageTitle>

@if (creature is null)
{
    <h1>Creature not found</h1>
    <p>Sorry, there are no records for this creature.</p>
}
else if (!profileLoaded)
{
    <p class="directory-detail-loading">Loading creature records…</p>
}
else
{
    <DirectoryDetailShell Name="@creature.Name"
                          HeroImagePath="@creature.SceneImagePath"
                          HeroImageAlt="@($"Cinematic illustration of a {creature.Name}")"
                          ShowPortraitHero="false"
                          Subtitle="@($"{creature.Habitat} · {creature.Homeworld}")"
                          Location="@location"
                          OverviewText="@(profile?.Overview ?? creature.Description)"
                          HistoryText="@(profile?.History ?? string.Empty)"
                          SignificanceText="@(profile?.Significance ?? string.Empty)"
                          SignificanceHeading="Ecology and galactic impact"
                          NotableEvents="@(profile?.NotableEvents ?? Array.Empty<string>())"
                          Affiliations="@(profile?.Affiliations ?? Array.Empty<string>())"
                          Timeline="@(profile?.Timeline ?? Array.Empty<ProfileTimelineEntry>())"
                          Gallery="@(profile?.Gallery ?? Array.Empty<ProfileImage>())"
                          AccentColor="@creature.Color">
        <a href="all-creatures">Back to all creatures</a>
    </DirectoryDetailShell>
    <EntityCrossLinks Links="@crossLinks" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private Creature? creature;
    private DirectoryProfile? profile;
    private bool profileLoaded;
    private ProfileLinkItem? location;
    private IReadOnlyList<EntityCrossLink> crossLinks = [];

    protected override async Task OnParametersSetAsync()
    {
        creature = CreatureData.GetBySlug(Slug);
        profileLoaded = false;
        profile = null;
        location = null;
        crossLinks = [];

        if (creature is not null)
        {
            profile = await ProfileService.GetProfileAsync("creatures", creature.Slug);
            crossLinks = await CrossLinkService.GetLinksAsync("creatures", creature.Slug);
            location = LocationService.GetLocationFromPlanetName(creature.Homeworld);
        }

        profileLoaded = true;
    }
}
