@page "/characters/{Slug}"
@using StarWars.Data
@using StarWars.Models
@using StarWars.Services
@using StarWars.Components
@inject DirectoryProfileService ProfileService
@inject EntityCrossLinkService CrossLinkService
@inject EntityLocationService LocationService

<PageTitle>@(character?.Name ?? "Character")</PageTitle>

@if (character is null)
{
    <h1>Character not found</h1>
    <p>Sorry, there are no records for this character.</p>
}
else if (!profileLoaded)
{
    <p class="directory-detail-loading">Loading character records…</p>
}
else
{
    <DirectoryDetailShell Name="@character.Name"
                          HeroImagePath="@character.SceneImagePath"
                          HeroImageAlt="@($"Cinematic illustration of {character.Name}")"
                          ShowPortraitHero="false"
                          Subtitle="@character.Role"
                          HomePlanet="@homePlanet"
                          OverviewText="@(profile?.Overview ?? character.Description)"
                          HistoryText="@(profile?.History ?? string.Empty)"
                          SignificanceText="@(profile?.Significance ?? string.Empty)"
                          SignificanceHeading="Legacy and impact"
                          NotableEvents="@(profile?.NotableEvents ?? Array.Empty<string>())"
                          Affiliations="@(profile?.Affiliations ?? Array.Empty<string>())"
                          Timeline="@(profile?.Timeline ?? Array.Empty<ProfileTimelineEntry>())"
                          Gallery="@(profile?.Gallery ?? Array.Empty<ProfileImage>())"
                          AccentColor="@character.Color" />
    <RelatedArchives Links="@crossLinks" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private Character? character;
    private DirectoryProfile? profile;
    private bool profileLoaded;
    private ProfileLinkItem? homePlanet;
    private IReadOnlyList<EntityCrossLink> crossLinks = [];

    protected override async Task OnParametersSetAsync()
    {
        character = CharacterData.GetBySlug(Slug);
        profileLoaded = false;
        profile = null;
        homePlanet = null;
        crossLinks = [];

        if (character is not null)
        {
            profile = await ProfileService.GetProfileAsync("characters", character.Slug);
            crossLinks = await CrossLinkService.GetLinksAsync("characters", character.Slug);
            homePlanet = await LocationService.GetHomePlanetAsync("characters", character.Slug);
        }

        profileLoaded = true;
    }
}
