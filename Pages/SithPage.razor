@page "/sith/{Slug}"
@using StarWars.Data
@using StarWars.Models
@using StarWars.Services
@using StarWars.Components
@inject DirectoryProfileService ProfileService

<PageTitle>@(sith?.Name ?? "Sith")</PageTitle>

@if (sith is null)
{
    <h1>Sith not found</h1>
    <p>Sorry, there are no records for this entry.</p>
}
else if (!profileLoaded)
{
    <p class="directory-detail-loading">Loading Sith records…</p>
}
else
{
    <DirectoryDetailShell Name="@sith.Name"
                          HeroImagePath="@sith.ImagePath"
                          HeroImageAlt="@($"Portrait of {sith.Name}")"
                          Subtitle="@sith.Title"
                          OverviewText="@(profile?.Overview ?? sith.Description)"
                          HistoryText="@(profile?.History ?? string.Empty)"
                          SignificanceText="@(profile?.Significance ?? string.Empty)"
                          SignificanceHeading="Dark side legacy"
                          NotableEvents="@(profile?.NotableEvents ?? Array.Empty<string>())"
                          Affiliations="@(profile?.Affiliations ?? Array.Empty<string>())"
                          Timeline="@(profile?.Timeline ?? Array.Empty<ProfileTimelineEntry>())"
                          Gallery="@(profile?.Gallery ?? Array.Empty<ProfileImage>())"
                          AccentColor="@sith.Color" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private SithMember? sith;
    private DirectoryProfile? profile;
    private bool profileLoaded;

    protected override async Task OnParametersSetAsync()
    {
        sith = SithData.GetBySlug(Slug);
        profileLoaded = false;
        profile = null;

        if (sith is not null)
        {
            profile = await ProfileService.GetProfileAsync("sith", sith.Slug);
        }

        profileLoaded = true;
    }
}
