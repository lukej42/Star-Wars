@page "/factions/{Slug}"
@using StarWars.Data
@using StarWars.Models
@using StarWars.Services
@using StarWars.Components
@inject DirectoryProfileService ProfileService
@inject EntityCrossLinkService CrossLinkService

<PageTitle>@(faction?.Name ?? "Faction")</PageTitle>

@if (faction is null)
{
    <h1>Faction not found</h1>
    <p>Sorry, there are no records for this faction.</p>
}
else if (!profileLoaded)
{
    <p class="directory-detail-loading">Loading faction records…</p>
}
else
{
    <DirectoryDetailShell Name="@faction.Name"
                          HeroImagePath="@faction.SceneImagePath"
                          HeroImageAlt="@($"Cinematic illustration of {faction.Name}")"
                          ShowPortraitHero="false"
                          Subtitle="@faction.Era"
                          MetaLine="@BuildMetaLine(faction)"
                          OverviewText="@(profile?.Overview ?? faction.Description)"
                          HistoryText="@(profile?.History ?? string.Empty)"
                          SignificanceText="@(profile?.Significance ?? string.Empty)"
                          SignificanceHeading="Legacy and impact"
                          NotableEvents="@(profile?.NotableEvents ?? Array.Empty<string>())"
                          Affiliations="@(profile?.Affiliations ?? Array.Empty<string>())"
                          Timeline="@(profile?.Timeline ?? Array.Empty<ProfileTimelineEntry>())"
                          Gallery="@(profile?.Gallery ?? Array.Empty<ProfileImage>())"
                          HeadOfGovernment="@profile?.HeadOfGovernment"
                          HeadOfState="@profile?.HeadOfState"
                          NumberOfSystems="@faction.NumberOfSystems"
                          MemberOrganizations="@memberOrganizations"
                          AccentColor="@faction.Color" />
    <EntityCrossLinks Links="@crossLinks" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private Faction? faction;
    private DirectoryProfile? profile;
    private bool profileLoaded;
    private IReadOnlyList<EntityCrossLink> crossLinks = [];
    private IReadOnlyList<ProfileLinkItem> memberOrganizations = [];

    protected override async Task OnParametersSetAsync()
    {
        faction = FactionData.GetBySlug(Slug);
        profileLoaded = false;
        profile = null;
        crossLinks = [];
        memberOrganizations = [];

        if (faction is not null)
        {
            profile = await ProfileService.GetProfileAsync("factions", faction.Slug);
            crossLinks = await CrossLinkService.GetLinksAsync("factions", faction.Slug);

            if (faction.Slug.Equals("confederacy", StringComparison.OrdinalIgnoreCase))
            {
                memberOrganizations = OrganizationData.GetByParentFaction(faction.Slug)
                    .Select(OrganizationLinks.ToLink)
                    .ToList();
            }
        }

        profileLoaded = true;
    }

    private static string BuildMetaLine(Faction faction) =>
        $"Active: {faction.YearsActive} · Capital: {faction.Capital} · {faction.Government}";
}
