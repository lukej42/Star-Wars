@page "/jedi/{Slug}"
@using StarWars.Data
@using StarWars.Models
@using StarWars.Services
@using StarWars.Components
@inject DirectoryProfileService ProfileService
@inject EntityCrossLinkService CrossLinkService
@inject EntityLocationService LocationService

<PageTitle>@(jedi?.Name ?? "Jedi")</PageTitle>

@if (jedi is null)
{
    <h1>Jedi not found</h1>
    <p>Sorry, there are no records for this Jedi.</p>
}
else if (!profileLoaded)
{
    <p class="directory-detail-loading">Loading Jedi records…</p>
}
else
{
    <DirectoryDetailShell Name="@jedi.Name"
                          HeroImagePath="@jedi.SceneImagePath"
                          HeroImageAlt="@($"Cinematic illustration of {jedi.Name}")"
                          ShowPortraitHero="false"
                          Subtitle="@jedi.Rank"
                          HomePlanet="@homePlanet"
                          LightsaberGlowPath="@LightsaberColorData.GetGlowPath("jedi", jedi.Slug)"
                          OverviewText="@(profile?.Overview ?? jedi.Description)"
                          HistoryText="@(profile?.History ?? string.Empty)"
                          SignificanceText="@(profile?.Significance ?? string.Empty)"
                          SignificanceHeading="Legacy and the Force"
                          NotableEvents="@(profile?.NotableEvents ?? Array.Empty<string>())"
                          NotableEventsAsideImagePath="@notableEventsAsideImagePath"
                          NotableEventsAsideImageAlt="@notableEventsAsideImageAlt"
                          Affiliations="@(profile?.Affiliations ?? Array.Empty<string>())"
                          Timeline="@(profile?.Timeline ?? Array.Empty<ProfileTimelineEntry>())"
                          Gallery="@(profile?.Gallery ?? Array.Empty<ProfileImage>())"
                          AccentColor="@jedi.Color" />
    <RelatedArchives Links="@crossLinks" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private JediMember? jedi;
    private DirectoryProfile? profile;
    private bool profileLoaded;
    private ProfileLinkItem? homePlanet;
    private IReadOnlyList<EntityCrossLink> crossLinks = [];
    private string notableEventsAsideImagePath = string.Empty;
    private string notableEventsAsideImageAlt = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        jedi = JediData.GetBySlug(Slug);
        profileLoaded = false;
        profile = null;
        homePlanet = null;
        crossLinks = [];
        notableEventsAsideImagePath = string.Empty;
        notableEventsAsideImageAlt = string.Empty;

        if (jedi is not null)
        {
            profile = await ProfileService.GetProfileAsync("jedi", jedi.Slug);
            crossLinks = await CrossLinkService.GetLinksAsync("jedi", jedi.Slug);
            homePlanet = await LocationService.GetHomePlanetAsync("jedi", jedi.Slug);

            if (jedi.Slug.Equals("yoda", StringComparison.OrdinalIgnoreCase))
            {
                notableEventsAsideImagePath = "/images/jedi/yoda-aside.webp";
                notableEventsAsideImageAlt = "Cinematic illustration of Yoda in the Jedi Temple";
            }
        }

        profileLoaded = true;
    }
}
